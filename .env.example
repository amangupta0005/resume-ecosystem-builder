# Neon PostgreSQL Database Connection URL
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Custom passcode for locking access to resume edits and preview
APP_PASSCODE="1234"

# Redis URL (automatically injected as redis://redis:6379 in Docker Compose)
REDIS_URL="redis://localhost:6379"

# Feature Flag: Enable/Disable AI capabilities (default: true)
AI_FEATURES_ENABLED="true"

# LLM Provider Configuration (Server-Side Only - Keys are never sent to client)
# Option 1: Google Gemini API (Recommended: gemini-1.5-flash or gemini-2.5-flash)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Option 2: OpenAI or OpenAI-Compatible Endpoints
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
